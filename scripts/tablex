#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RUNTIME_DIR="$ROOT/.tablex-runtime"
VENV_DIR="$RUNTIME_DIR/venv"
UV_BIN="$RUNTIME_DIR/uv"
UV_IMAGE="ghcr.io/astral-sh/uv@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa"
PID_FILE="$RUNTIME_DIR/agent-supervisor.pid"
LOG_FILE="$RUNTIME_DIR/agent-supervisor.log"
WORKER_PID_FILE="$RUNTIME_DIR/codex-worker.pid"
WORKER_LOG_FILE="$RUNTIME_DIR/codex-worker.log"
SYSTEMD_USER_DIR=${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user
SUPERVISOR_UNIT=tablex-agent-supervisor.service
WORKER_UNIT=tablex-codex-worker.service
DATA_DIR=${TABLEX_DATA_DIR:-"$ROOT/data"}
CODEX_AUTH_DIR=${CODEX_HOME:-"$HOME/.codex"}
HOST_UID=${TABLEX_UID:-$(id -u)}
HOST_GID=${TABLEX_GID:-$(id -g)}
AUTOSTART=${TABLEX_AUTOSTART:-1}

die() {
  printf '%s\n' "Tablex: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required."
}

run_detached() {
  trap '' HUP
  if command -v setsid >/dev/null 2>&1; then
    exec setsid "$@"
  fi
  exec "$@"
}

install_uv() {
  [ -x "$UV_BIN" ] && return
  cid=$(docker create "$UV_IMAGE") || die "Unable to create the pinned uv bootstrap container."
  if ! docker cp "$cid:/uv" "$UV_BIN.tmp"; then
    docker rm "$cid" >/dev/null 2>&1 || true
    rm -f "$UV_BIN.tmp"
    die "Unable to extract uv from its official bootstrap image."
  fi
  docker rm "$cid" >/dev/null
  mv "$UV_BIN.tmp" "$UV_BIN"
  chmod 0755 "$UV_BIN"
}

setup_runtime() {
  require_command docker
  mkdir -p "$RUNTIME_DIR" "$DATA_DIR"
  install_uv
  if [ ! -x "$VENV_DIR/bin/tablex-agent-supervisor" ]; then
    "$UV_BIN" venv --clear --python 3.12 "$VENV_DIR"
  fi
  "$UV_BIN" pip install --python "$VENV_DIR/bin/python" --editable "$ROOT"
}

supervisor_running() {
  [ -f "$PID_FILE" ] || return 1
  pid=$(cat "$PID_FILE")
  kill -0 "$pid" 2>/dev/null
}

worker_running() {
  [ -f "$WORKER_PID_FILE" ] || return 1
  worker_pid=$(cat "$WORKER_PID_FILE")
  kill -0 "$worker_pid" 2>/dev/null
}

user_systemd_available() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

systemd_escape_value() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/%/%%/g'
}

systemd_escape_path() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/%/%%/g' -e 's/ /\\x20/g' -e 's/	/\\x09/g'
}

write_user_service_units() {
  mkdir -p "$SYSTEMD_USER_DIR"
  codex_bin_dir=$(dirname "$(command -v codex)")
  service_path=${TABLEX_SERVICE_PATH:-"$codex_bin_dir:$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}
  escaped_root=$(systemd_escape_path "$ROOT")
  escaped_data_dir=$(systemd_escape_value "$DATA_DIR")
  escaped_codex_auth_dir=$(systemd_escape_value "$CODEX_AUTH_DIR")
  escaped_tablex_codex_home=$(systemd_escape_value "$RUNTIME_DIR/codex-home")
  escaped_path=$(systemd_escape_value "$service_path")
  escaped_supervisor=$(systemd_escape_value "$VENV_DIR/bin/tablex-agent-supervisor")
  escaped_worker=$(systemd_escape_value "$VENV_DIR/bin/tablex-worker")

  cat >"$SYSTEMD_USER_DIR/$SUPERVISOR_UNIT" <<EOF
[Unit]
Description=Tablex Full Auto recovery
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=$escaped_root
Environment="HOME=$(systemd_escape_value "$HOME")"
Environment="PATH=$escaped_path"
Environment="CODEX_HOME=$escaped_codex_auth_dir"
Environment="HARNESS_DATA_DIR=$escaped_data_dir"
Environment="TABLEX_CODEX_HOME=$escaped_tablex_codex_home"
ExecStart="$escaped_supervisor" --interval 15 --owner-id host-agent-supervisor
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
EOF

  cat >"$SYSTEMD_USER_DIR/$WORKER_UNIT" <<EOF
[Unit]
Description=Tablex Codex job worker
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=$escaped_root
Environment="HOME=$(systemd_escape_value "$HOME")"
Environment="PATH=$escaped_path"
Environment="CODEX_HOME=$escaped_codex_auth_dir"
Environment="HARNESS_DATA_DIR=$escaped_data_dir"
Environment="TABLEX_CODEX_HOME=$escaped_tablex_codex_home"
ExecStart="$escaped_worker" --interval 2 --worker-id host-codex-worker --no-agent-session-supervisor --job-type generate_user_avatar_candidates --job-type agent_chat_turn --job-type run_planned_agent_task_codex --job-type continue_autonomous_session
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
EOF
}

stop_user_services() {
  if user_systemd_available; then
    systemctl --user disable --now "$SUPERVISOR_UNIT" "$WORKER_UNIT" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$SUPERVISOR_UNIT" "$WORKER_UNIT" >/dev/null 2>&1 || true
  fi
}

start_user_services() {
  write_user_service_units
  systemctl --user daemon-reload
  systemctl --user enable "$SUPERVISOR_UNIT" "$WORKER_UNIT" >/dev/null
  systemctl --user restart "$WORKER_UNIT" "$SUPERVISOR_UNIT"
  rm -f "$PID_FILE" "$WORKER_PID_FILE"
}

start_host_companions() {
  if [ "$AUTOSTART" != "0" ] && user_systemd_available; then
    start_user_services
    printf '%s\n' "Tablex: automatic Full Auto recovery is enabled for this user session."
    return
  fi
  start_codex_worker
  start_supervisor
  if [ "$AUTOSTART" != "0" ]; then
    printf '%s\n' "Tablex: user services are unavailable; run scripts/tablex up after an OS restart."
  fi
}

check_runtime() {
  if ! TABLEX_CODEX_HOME="$RUNTIME_DIR/codex-home" \
    "$VENV_DIR/bin/tablex-agent-supervisor" --check-runtime; then
    die "Codex runtime check failed. On Linux, install the official bubblewrap/AppArmor prerequisites before starting Tablex."
  fi
}

start_supervisor() {
  if supervisor_running; then
    return
  fi
  HARNESS_DATA_DIR="$DATA_DIR" \
    TABLEX_CODEX_HOME="$RUNTIME_DIR/codex-home" \
    run_detached "$VENV_DIR/bin/tablex-agent-supervisor" \
      --interval 15 \
      --owner-id host-agent-supervisor \
      </dev/null >>"$LOG_FILE" 2>&1 &
  printf '%s\n' "$!" >"$PID_FILE"
}

start_codex_worker() {
  if worker_running; then
    return
  fi
  HARNESS_DATA_DIR="$DATA_DIR" \
    TABLEX_CODEX_HOME="$RUNTIME_DIR/codex-home" \
    run_detached "$VENV_DIR/bin/tablex-worker" \
      --interval 2 \
      --worker-id host-codex-worker \
      --no-agent-session-supervisor \
      --job-type generate_user_avatar_candidates \
      --job-type agent_chat_turn \
      --job-type run_planned_agent_task_codex \
      --job-type continue_autonomous_session \
      </dev/null >>"$WORKER_LOG_FILE" 2>&1 &
  printf "%s\n" "$!" >"$WORKER_PID_FILE"
}

host_nvidia_gpu_available() {
  command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1
}

resource_snapshot_path() {
  printf '%s\n' "$DATA_DIR/runtime/compute-resources.json"
}

persist_cpu_resource_snapshot() {
  snapshot=$(resource_snapshot_path)
  mkdir -p "$(dirname "$snapshot")"
  if docker run --rm \
    -e TABLEX_RUNTIME_LOCATION=isolated_compute_executor \
    -e TABLEX_COMPUTE_DEVICE_MODE=cpu \
    tablex:local \
    python -m tabular_harness.core.runtime_resources >"$snapshot.tmp"; then
    mv "$snapshot.tmp" "$snapshot"
    return 0
  fi
  rm -f "$snapshot.tmp"
  return 1
}

gpu_image_ready() {
  snapshot=$(resource_snapshot_path)
  mkdir -p "$(dirname "$snapshot")"
  if ! docker run --rm --gpus all \
    -e TABLEX_RUNTIME_LOCATION=gpu_startup_probe \
    -e TABLEX_COMPUTE_DEVICE_MODE=gpu \
    tablex-gpu:local \
    python -m tabular_harness.core.runtime_resources >"$snapshot.gpu.tmp"; then
    rm -f "$snapshot.gpu.tmp"
    return 1
  fi
  if ! "$VENV_DIR/bin/python" -c 'import json,sys; value=json.load(open(sys.argv[1], encoding="utf-8")); raise SystemExit(0 if value.get("gpu", {}).get("usable_for_compute") is True else 1)' "$snapshot.gpu.tmp"; then
    rm -f "$snapshot.gpu.tmp"
    return 1
  fi
  mv "$snapshot.gpu.tmp" "$snapshot"
}

start_compose_services() {
  TABLEX_DATA_DIR="$DATA_DIR" TABLEX_CODEX_AUTH_DIR="$CODEX_AUTH_DIR" TABLEX_UID="$HOST_UID" TABLEX_GID="$HOST_GID" \
    docker compose -f "$ROOT/docker-compose.yml" build tablex-api tablex-worker tablex-compute-executor
  persist_cpu_resource_snapshot || printf '%s\n' "Tablex: CPU runtime capability snapshot could not be persisted."
  if host_nvidia_gpu_available; then
    printf '%s\n' "Tablex: NVIDIA GPU detected; preparing the optional GPU runtime."
    if TABLEX_DATA_DIR="$DATA_DIR" TABLEX_CODEX_AUTH_DIR="$CODEX_AUTH_DIR" TABLEX_UID="$HOST_UID" TABLEX_GID="$HOST_GID" \
      docker compose -f "$ROOT/docker-compose.yml" -f "$ROOT/docker-compose.gpu.yml" build tablex-worker tablex-compute-executor \
      && gpu_image_ready; then
      TABLEX_DATA_DIR="$DATA_DIR" TABLEX_CODEX_AUTH_DIR="$CODEX_AUTH_DIR" TABLEX_UID="$HOST_UID" TABLEX_GID="$HOST_GID" \
        docker compose -f "$ROOT/docker-compose.yml" -f "$ROOT/docker-compose.gpu.yml" up -d --remove-orphans tablex-api tablex-worker tablex-compute-executor
      printf '%s\n' "Tablex: GPU runtime is available to Codex-managed compute and compatible prediction pipelines."
      return
    fi
    printf '%s\n' "Tablex: GPU runtime probe failed; continuing with the CPU runtime."
  fi
  TABLEX_DATA_DIR="$DATA_DIR" TABLEX_CODEX_AUTH_DIR="$CODEX_AUTH_DIR" TABLEX_UID="$HOST_UID" TABLEX_GID="$HOST_GID" \
    docker compose -f "$ROOT/docker-compose.yml" up -d --remove-orphans tablex-api tablex-worker tablex-compute-executor
}

stop_supervisor() {
  if supervisor_running; then
    pid=$(cat "$PID_FILE")
    child_pids=$(ps -eo pid=,ppid= | awk -v parent="$pid" '$2 == parent {print $1}')
    if [ -n "$child_pids" ]; then
      kill $child_pids 2>/dev/null || true
    fi
    kill "$pid"
    attempts=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 100 ]; do
      sleep 0.2
      attempts=$((attempts + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PID_FILE"
}

stop_codex_worker() {
  if worker_running; then
    worker_pid=$(cat "$WORKER_PID_FILE")
    kill "$worker_pid"
    wait "$worker_pid" 2>/dev/null || true
  fi
  rm -f "$WORKER_PID_FILE"
}

case ${1:-up} in
  setup)
    setup_runtime
    require_command codex
    codex login status
    check_runtime
    ;;
  up)
    require_command docker
    setup_runtime
    require_command codex
    codex login status >/dev/null 2>&1 || die "Codex is not authenticated. Run: codex login --device-auth"
    check_runtime
    stop_user_services
    stop_supervisor
    stop_codex_worker
    start_compose_services
    start_host_companions
    printf '%s\n' "Tablex: http://localhost:8080"
    ;;
  enable-autostart)
    setup_runtime
    require_command codex
    codex login status >/dev/null 2>&1 || die "Codex is not authenticated. Run: codex login --device-auth"
    check_runtime
    user_systemd_available || die "A running systemd user session is required for automatic recovery."
    stop_supervisor
    stop_codex_worker
    start_user_services
    printf '%s\n' "Tablex: automatic Full Auto recovery is enabled for this user session."
    ;;
  disable-autostart)
    stop_user_services
    printf '%s\n' "Tablex: automatic Full Auto recovery is disabled."
    ;;
  down)
    stop_user_services
    stop_codex_worker
    stop_supervisor
    TABLEX_DATA_DIR="$DATA_DIR" TABLEX_CODEX_AUTH_DIR="$CODEX_AUTH_DIR" TABLEX_UID="$HOST_UID" TABLEX_GID="$HOST_GID" docker compose -f "$ROOT/docker-compose.yml" down
    ;;
  status)
    TABLEX_DATA_DIR="$DATA_DIR" TABLEX_CODEX_AUTH_DIR="$CODEX_AUTH_DIR" TABLEX_UID="$HOST_UID" TABLEX_GID="$HOST_GID" docker compose -f "$ROOT/docker-compose.yml" ps
    if user_systemd_available && systemctl --user is-active --quiet "$SUPERVISOR_UNIT"; then
      printf '%s\n' "host agent supervisor: running (automatic recovery enabled)"
    elif supervisor_running; then
      printf 'host agent supervisor: running (pid %s)\n' "$(cat "$PID_FILE")"
    else
      printf '%s\n' "host agent supervisor: stopped"
    fi
    if user_systemd_available && systemctl --user is-active --quiet "$WORKER_UNIT"; then
      printf '%s\n' "host Codex worker: running (automatic recovery enabled)"
    elif worker_running; then
      printf 'host Codex worker: running (pid %s)\n' "$(cat "$WORKER_PID_FILE")"
    else
      printf '%s\n' "host Codex worker: stopped"
    fi
    ;;
  logs)
    if user_systemd_available && {
      systemctl --user is-active --quiet "$SUPERVISOR_UNIT" || systemctl --user is-active --quiet "$WORKER_UNIT";
    }; then
      journalctl --user -f -u "$SUPERVISOR_UNIT" -u "$WORKER_UNIT"
    else
      touch "$LOG_FILE" "$WORKER_LOG_FILE"
      tail -f "$LOG_FILE" "$WORKER_LOG_FILE"
    fi
    ;;
  *)
    die "usage: scripts/tablex [setup|up|enable-autostart|disable-autostart|down|status|logs]"
    ;;
esac
