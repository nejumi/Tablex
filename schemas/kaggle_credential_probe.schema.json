{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KaggleCredentialProbe",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_name",
    "source_kind",
    "competition_slug",
    "checked_at",
    "credential_status",
    "request",
    "probe",
    "safety",
    "next_actions"
  ],
  "properties": {
    "schema_version": { "const": "kaggle_credential_probe.v1" },
    "benchmark_id": { "type": "string" },
    "benchmark_name": { "type": "string" },
    "source_kind": { "type": "string" },
    "competition_slug": { "type": "string" },
    "checked_at": { "type": "string" },
    "credential_status": {
      "type": "object",
      "required": [
        "available",
        "candidate_count",
        "credential_sources",
        "auth_schemes",
        "username_available",
        "missing",
        "warnings",
        "values_exposed"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "credential_sources": { "type": "array", "items": { "type": "string" } },
        "auth_schemes": { "type": "array", "items": { "type": "string" } },
        "username_available": { "type": "boolean" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "values_exposed": { "const": false }
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": ["endpoint_kind", "url_host", "network_accessed"],
      "additionalProperties": true
    },
    "probe": {
      "type": "object",
      "required": [
        "status",
        "http_status",
        "can_access_competition_files",
        "file_count",
        "attempt_count",
        "attempts"
      ],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "secret_value_logged",
        "secret_value_artifacted",
        "connector_credentials_materialized",
        "agent_runner_access",
        "agent_task_contract_access"
      ],
      "properties": {
        "secret_value_logged": { "const": false },
        "secret_value_artifacted": { "const": false },
        "connector_credentials_materialized": { "const": false },
        "agent_runner_access": { "const": false },
        "agent_task_contract_access": { "const": false }
      },
      "additionalProperties": true
    },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
