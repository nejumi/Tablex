{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualizationSpec",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "chart_type",
    "data",
    "encoding",
    "empty_state"
  ],
  "properties": {
    "schema_version": {
      "const": "visualization_spec.v1"
    },
    "title": {
      "type": "string"
    },
    "chart_type": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "encoding": {
      "type": "object"
    },
    "empty_state": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
