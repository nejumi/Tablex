{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunReport",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "summary",
    "severity",
    "metrics",
    "diagnostics_summary",
    "recommended_next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "run_report.v1"
    },
    "project_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "diagnostics_artifact_id": {
      "type": ["string", "null"]
    },
    "plan_artifact_id": {
      "type": ["string", "null"]
    },
    "diagnostics_summary": {
      "type": "object"
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
