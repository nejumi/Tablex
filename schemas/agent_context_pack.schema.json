{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentContextPack",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "project",
    "idea",
    "agent_task_contract",
    "research_policy",
    "safety_controls",
    "data_context",
    "evaluation_context",
    "quality_gate_context",
    "relational_context",
    "relational_feature_plan_context",
    "relational_feature_recipe_context",
    "research_plan_context",
    "research_synthesis_context",
    "artifact_refs",
    "library_asset_references",
    "asset_recommendations",
    "materialized_library_assets",
    "required_outputs",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_context_pack.v1"
    },
    "id": {
      "type": "string"
    },
    "project": {
      "type": "object"
    },
    "idea": {
      "type": "object"
    },
    "agent_task_contract": {
      "type": "object"
    },
    "research_policy": {
      "type": "object"
    },
    "safety_controls": {
      "type": "object"
    },
    "data_context": {
      "type": "object"
    },
    "evaluation_context": {
      "type": "object"
    },
    "quality_gate_context": {
      "type": "object"
    },
    "relational_context": {
      "type": "object"
    },
    "relational_feature_plan_context": {
      "type": "object"
    },
    "relational_feature_recipe_context": {
      "type": "object"
    },
    "research_plan_context": {
      "type": "object"
    },
    "research_synthesis_context": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "library_asset_references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "asset_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_type",
          "name",
          "asset_version_id",
          "artifact_id",
          "source",
          "reason"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_version_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "artifact_filename": {
            "type": "string"
          },
          "artifact_content_hash": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "explicit_reference",
              "research_plan"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relation_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "materialize": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "materialized_library_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_type",
          "name",
          "asset_version_id",
          "artifact_id",
          "context_path",
          "reason"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "asset_version_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "context_path": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
