{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResult",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "final_message",
    "outputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_approval",
        "gave_up"
      ]
    },
    "final_message": {
      "type": "string"
    },
    "outputs": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "asset_type"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "give_up_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_next_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patch_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_assumption_updates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proposed_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_type",
          "title",
          "verification_status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "local_artifact",
              "verified",
              "unverified",
              "not_accessed",
              "policy_placeholder"
            ]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "freshness": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "citation_id",
          "source_id",
          "claim"
        ],
        "properties": {
          "citation_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "usage_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "requires_follow_up": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "report_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "citation_ids"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "proposed_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "requires_human_review": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
