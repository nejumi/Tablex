{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tablex.local/schemas/evaluation_approval_review.schema.json",
  "title": "EvaluationApprovalReview",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "evaluation_spec",
    "dataset",
    "context",
    "blockers",
    "assumption_backed_proceed",
    "findings",
    "decision_support"
  ],
  "properties": {
    "schema_version": { "const": "evaluation_approval_review.v1" },
    "project": { "type": "object" },
    "evaluation_spec": { "type": "object" },
    "dataset": { "type": "object" },
    "context": {
      "type": "object",
      "properties": {
        "scenario_comparison": { "type": "object" },
        "quality_gate": { "type": "object" },
        "relational_catalog": { "type": "object" }
      },
      "additionalProperties": true
    },
    "blockers": {
      "type": "object",
      "required": ["questions", "assumptions"],
      "properties": {
        "questions": { "type": "array", "items": { "type": "object" } },
        "assumptions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "assumption_backed_proceed": {
      "type": "object",
      "properties": {
        "open_questions": { "type": "array", "items": { "type": "object" } },
        "active_assumptions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "severity", "summary", "recommendation"],
        "properties": {
          "topic": { "type": "string" },
          "severity": { "type": "string" },
          "summary": { "type": "string" },
          "recommendation": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "decision_support": {
      "type": "object",
      "required": [
        "review_status",
        "blocked",
        "can_approve_evaluation_spec",
        "recommended_action",
        "blocker_count",
        "warning_count"
      ],
      "properties": {
        "review_status": { "enum": ["ready", "ready_with_assumptions", "blocked"] },
        "blocked": { "type": "boolean" },
        "can_approve_evaluation_spec": { "type": "boolean" },
        "approval_intent": { "type": "boolean" },
        "recommended_action": { "type": "string" },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
