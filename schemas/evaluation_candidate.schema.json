{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationCandidate",
  "type": "object",
  "required": [
    "evaluation_candidate_id",
    "project_id",
    "dataset_snapshot_id",
    "split_type",
    "primary_metric",
    "excluded_columns",
    "assumption_ids",
    "rationale",
    "confidence",
    "risk_level",
    "status"
  ],
  "properties": {
    "evaluation_candidate_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "dataset_snapshot_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "split_type": {
      "type": "string",
      "enum": [
        "random",
        "stratified",
        "time",
        "group",
        "time_group",
        "rolling",
        "leave_group_out",
        "duplicate_aware",
        "custom"
      ]
    },
    "primary_metric": {
      "type": "string"
    },
    "secondary_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_column": {
      "type": [
        "string",
        "null"
      ]
    },
    "group_column": {
      "type": [
        "string",
        "null"
      ]
    },
    "stratify_column": {
      "type": [
        "string",
        "null"
      ]
    },
    "excluded_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumption_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocking"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "primary_candidate",
        "alternative",
        "promoted_to_spec",
        "rejected",
        "deprecated",
        "proposed_after_reflection"
      ]
    }
  },
  "additionalProperties": false
}